{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node", "vitest/config"],
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode (mirrors tsconfig.node.json, but with moduleResolution
       bundler so the server's extensionless relative imports don't need
       nodenext's explicit .js suffixes — see tsconfig.server.json note below) */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server/**/*.ts", "src/data/schema.ts", "src/shared/**/*.ts", "src/engine/types.ts"]
}
